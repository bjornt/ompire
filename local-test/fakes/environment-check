#!/usr/bin/env bash
# Read-only readiness probe; environmentctl owns the disposable control file.
set -euo pipefail
[ "$#" -eq 0 ] || { printf 'unsupported environment-check arguments\n' >&2; exit 2; }
: "${LOCAL_TEST_STATE:?LOCAL_TEST_STATE is required}"
name=fixture
if [ "$(basename "$0")" = sandbox-qa-check ]; then name=sandbox-qa; fi
control="$LOCAL_TEST_STATE/environment/state"
if [ "$name" = sandbox-qa ]; then control="$LOCAL_TEST_STATE/environment/sandbox-qa/state"; fi
[ -f "$control" ] || { printf '%s environment has not been initialized\n' "$name" >&2; exit 2; }
IFS= read -r state <"$control"
case "$state" in
ready) exit 0 ;;
degraded) printf '%s browser provider is not answering\n' "$name" >&2; exit 1 ;;
*) printf 'unsupported %s environment state: %s\n' "$name" "$state" >&2; exit 2 ;;
esac
