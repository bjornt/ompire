#!/usr/bin/env python3
"""Fake omp: deterministic rpc-ui scenario engine for offline local E2E
(LOCAL-TESTING.PLAN.md Part 4). The daemon (unmodified) execs this through
the fake `workshop` (Part 3) — `workshop exec -p <clone> -- [env …] omp …` —
so this process's cwd is the task clone and stdio carries the rpc-ui NDJSON.

Consumed contracts (daemon call sites):
  agent.py:verify_ask_timeout   omp config get ask.timeout       -> "0", rc 0
  agent.py:build_agent_argv     omp --mode rpc-ui --no-title
                                [--model M] [--thinking T]
                                [--smol/--slow/--plan P:L] [--resume <id>]
  agent.py AgentHandle          ready handshake; prompt bursts;
                                get_state / set_model / set_thinking_level /
                                get_session_stats / steer /
                                follow_up / abort_and_prompt
  ship.py ShipManager.draft     get_last_assistant_text -> {"data":{"text":…}}
  workflows.py                  .ompire/outcome.json written by the "agent"
  review.py                     llmvet comment loopback prompts

The frame shapes are the corpus recorded from real omp (16.5.2 / 17.2.12)
that daemon/tests/fake_omp.py also uses; config/version output shapes were
captured live from omp 17.0.1 inside the QA workshop container.

Scenario selection happens at prompt time (the daemon authors the prompts):
  1. a [[scenario:<name>]] line in the prompt text (+ [[scenario-param:k=v]])
  2. a one-shot armed scenario in <state>/omp-scenarios.json (clone, global)
  3. classification of daemon-authored prompts (ship draft markers, resume
     nudge, retry preamble, blockquoted review comments)
  4. default: happy
Process-level scenarios (silent, crash, exit-after-ready, ignore-term,
get-state-fails) resolve at launch from the control file's startup slot.

State layout (under $LOCAL_TEST_STATE, else local-test/.state):
  omp-scenarios.json   {"startup": {...}, "next_prompt": {...}}
  omp-sessions/<id>.jsonl   per-session transcript (launch/prompt/exit)

Usage: omp config get ask.timeout | omp --version
       omp [--mode rpc-ui --no-title] [--model M] [--thinking T]
           [--smol P:L] [--slow P:L] [--plan P:L]
           [--resume <id>]
       omp selfcheck
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path

CAPTURED_VERSION = "17.0.1"

# --- literals from the daemon source (classification anchors) ---------------
# ship.py:_DRAFT_PROMPT carries these markers.
_DRAFT_MARKERS = ("<<<COMMIT_MESSAGE>>>", "<<<PR_TITLE>>>")
# workflows.py:RESUME_NUDGE.
_NUDGE_PREFIX = "The daemon restarted while you were working; please continue."
# workflows.py:RETRY_PREFIX — an operator-authorized retry after an
# uncertainty pause. Deliberately distinct from the restart nudge: the
# previous turn ran to completion, so this one is told to inspect first.
_RETRY_PREFIX = "Your previous attempt at this step finished without leaving"
# review.py:_COMMENTS_PROMPT_PREFIX opens every comment loopback.
_REVIEW_PREFIX = "The reviewer left the following comments on your changes."
# workflows.py:OUTCOME_INSTRUCTION and result_instruction both name this
# path inside backticks.
_OUTCOME_HINT = "`.ompire/outcome.json`"
# workflows.py:result_instruction — the format-2 envelope. Its presence is how
# this fake tells which result contract it is being asked to satisfy.
_RESULT_HINT = '"version": 2,'
# One declared result in that instruction:
#   - "reproduced" — required artifacts: attempts (string), script_available (boolean)
#   - "no-root-cause" — no required artifacts
_RESULT_RE = re.compile(
    r'^- "([a-z0-9-]+)" — (?:required artifacts: (.+)|no required artifacts)$',
    re.MULTILINE,
)
_FIELD_RE = re.compile(r"([A-Za-z_][A-Za-z0-9_]*) \((\w+)\)")

OUTCOME_PATH = ".ompire/outcome.json"
WORK_ARTIFACT = "fake-agent-work.txt"

_SCENARIO_RE = re.compile(r"\[\[scenario:([a-z0-9-]+)\]\]")
_PARAM_RE = re.compile(r"\[\[scenario-param:([a-z0-9-]+)=([^\]]*)\]\]")

KNOWN_SCENARIOS = {
    # behavior
    "happy", "outcome-failed", "no-outcome", "ship-draft", "review-comments",
    "resume-nudge", "retry-prefix", "commit", "plan-files",
    # protocol (promoted from daemon/tests/fake_omp.py)
    "die", "fail", "garbage", "big", "queue", "no-end", "ask", "approve",
    "ask-cancel", "bad-ask", "auto-retry", "auto-retry-hang",
    # process-level (startup slot only)
    "silent", "crash", "exit-after-ready", "ignore-term", "get-state-fails",
}
STARTUP_SCENARIOS = {"silent", "crash", "exit-after-ready", "ignore-term",
                     "get-state-fails"}

USAGE = __doc__.split("State layout")[0].strip()


def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(2)


def unsupported(argv: list[str]) -> None:
    print(f"unsupported invocation: {' '.join(argv)}", file=sys.stderr)
    sys.exit(2)


# --- state helpers -----------------------------------------------------------

def state_root() -> Path:
    root = os.environ.get("LOCAL_TEST_STATE")
    return Path(root) if root else Path(__file__).resolve().parent.parent / ".state"


def _atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _read_control() -> dict:
    path = state_root() / "omp-scenarios.json"
    try:
        with path.open(encoding="utf-8") as fh:
            doc = json.load(fh)
        return doc if isinstance(doc, dict) else {}
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError:
        # Corrupt control file: treat as empty but never crash the session.
        return {}


def _write_control(doc: dict) -> None:
    _atomic_write(
        state_root() / "omp-scenarios.json",
        json.dumps(
            {"startup": doc.get("startup", {}),
             "next_prompt": doc.get("next_prompt", {})},
            indent=2, sort_keys=True,
        ) + "\n",
    )


def _consume_slot(slot: str, session_id: str | None = None) -> str | None:
    """One-shot consume. next_prompt: clone, then session, then global;
    startup: clone, then global (session identity does not exist before
    launch). Nulls the consumed key."""
    doc = _read_control()
    entries = doc.get(slot, {})
    if not isinstance(entries, dict):
        return None
    clone = str(Path.cwd().resolve())
    keys = [clone]
    if slot != "startup" and session_id is not None:
        keys.append(session_id)
    keys.append("global")
    for key in keys:
        value = entries.get(key)
        if value is None:
            continue
        entries[key] = None
        doc[slot] = entries
        _write_control(doc)
        return value if isinstance(value, str) else None
    return None


# --- transcript store --------------------------------------------------------

class Transcript:
    """Append-only per-session JSONL: launch/prompt/exit records."""

    def __init__(self, session_id: str) -> None:
        self.path = state_root() / "omp-sessions" / f"{session_id}.jsonl"
        self.path.parent.mkdir(parents=True, exist_ok=True)

    def append(self, record: dict) -> None:
        record = dict(record, ts=_now_iso())
        with self.path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")

    def load(self) -> list[dict]:
        records: list[dict] = []
        try:
            with self.path.open(encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        records.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue  # torn append: skip, degrade gracefully
        except FileNotFoundError:
            pass
        return records


def _now_iso() -> str:
    import datetime

    return datetime.datetime.now(datetime.timezone.utc).isoformat()


# --- frame emission ----------------------------------------------------------

def emit(frame: dict) -> None:
    print(json.dumps(frame), flush=True)


# --- scenario side effects ---------------------------------------------------

def write_outcome(scenario: str, turn: int, status: str = "success",
                  artifacts: dict | None = None) -> None:
    document: dict = {
        "version": 1,
        "status": status,
        "summary": f"fake omp {scenario} turn {turn}",
    }
    if artifacts is not None:
        document["artifacts"] = artifacts
    path = Path.cwd() / OUTCOME_PATH
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(document, indent=2) + "\n", encoding="utf-8")


def parse_result_contract(message: str) -> list[tuple[str, list[tuple[str, str]]]]:
    """The results this step declares, read out of its own instruction.

    The fake does not know the bugfix workflow. It reads the contract the
    daemon actually sent and satisfies that, so a definition edit changes what
    this fake produces without anyone editing the fake — and a scenario that
    asks for a result the step does not declare fails loudly rather than
    quietly writing something the engine will reject.
    """
    results: list[tuple[str, list[tuple[str, str]]]] = []
    for match in _RESULT_RE.finditer(message):
        name, fields = match.group(1), match.group(2)
        required = _FIELD_RE.findall(fields) if fields else []
        results.append((name, required))
    return results


def _artifact_value(field: str, declared: str, params: dict) -> object:
    if declared == "boolean":
        # `script_available` decides whether the bugfix flow runs its
        # reproducer script, so a scenario has to be able to steer it.
        default = params.get("script", "true") == "true"
        return default if field == "script_available" else True
    if declared in ("integer", "number"):
        return 1
    if declared == "array":
        return [f"fake omp {field}"]
    if declared == "object":
        return {"note": f"fake omp {field}"}
    return f"fake omp: {field.replace('_', ' ')}"


def write_result(scenario: str, turn: int, message: str, params: dict) -> str | None:
    """Write a format-2 result satisfying this step's declared contract.

    Which result is chosen comes from the ordered `results` parameter: the
    first entry this step actually declares is taken and consumed, so one
    parameter drives a whole multi-step flow without the fake knowing the
    workflow's shape. With nothing left to match, the step's first declared
    result is used.
    """
    declared = parse_result_contract(message)
    if not declared:
        return None
    names = [name for name, _fields in declared]
    queue = [item for item in (params.get("results") or "").split(",") if item]
    chosen = next((item for item in queue if item in names), None)
    if chosen is not None:
        queue.remove(chosen)
        params["results"] = ",".join(queue)
    else:
        chosen = names[0]
    required = dict(declared)[chosen]
    document = {
        "version": 2,
        "result": chosen,
        "summary": f"fake omp {scenario} turn {turn}: {chosen}",
        "artifacts": {
            field: _artifact_value(field, declared_type, params)
            for field, declared_type in required
        },
    }
    path = Path.cwd() / OUTCOME_PATH
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(document, indent=2) + "\n", encoding="utf-8")
    # Make the claim true on disk, so a workflow that routes on it finds what
    # it was told to expect.
    if document["artifacts"].get("script_available") is True:
        write_repro_script()
    if chosen == "implemented":
        mark_fixed()
    return chosen


# A workflow step can declare that a runnable reproducer exists. Claiming one
# without leaving it behind would make the engine run a script that is not
# there and read the shell's "no such file" as the bug still being present —
# a fake failure that looks exactly like a real one.
REPRO_SCRIPT = ".ompire/repro.sh"
FIXED_MARKER = ".ompire/fixed"


def write_repro_script() -> None:
    """Leave a reproducer that fails until a fix lands, then passes."""
    path = Path.cwd() / REPRO_SCRIPT
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "#!/bin/sh\n"
        "# fake omp reproducer: non-zero while the bug is present.\n"
        f'[ -f "{FIXED_MARKER}" ] || {{ echo "bug still present"; exit 1; }}\n'
        'echo "behaves correctly"\n',
        encoding="utf-8",
    )
    path.chmod(0o755)


def mark_fixed() -> None:
    """What a fix changes, from the reproducer's point of view."""
    path = Path.cwd() / FIXED_MARKER
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("fixed by fake omp\n", encoding="utf-8")


# A planning task's real output: ordinary Markdown at the paths the planning
# skills use, written into the workspace and committed nowhere. This is what
# makes durable-result capture testable end to end — the daemon has to retain
# bytes an agent actually wrote, and a second turn has to change them so a
# successor revision differs from its predecessor in a checkable way.
PLAN_DIR_DEFAULT = "epics/local-e2e"


def write_plan_files(turn: int, params: dict) -> list[str]:
    """Write (or revise) planning files, and deliberately commit nothing."""
    relative = params.get("plan-dir", PLAN_DIR_DEFAULT)
    directory = Path.cwd() / relative
    directory.mkdir(parents=True, exist_ok=True)
    written: list[str] = []
    for name, heading in (("SPEC.md", "Spec"), ("PLAN.md", "Plan")):
        body = [f"# {heading}", "", f"Revision {turn} written by fake omp.", ""]
        body.append("- the original point")
        # A later turn revises one line and adds another, so a successor
        # capture has both a change and an addition to show.
        if turn > 1:
            body[-1] = f"- the revised point (turn {turn})"
            body.append(f"- an added point (turn {turn})")
        (directory / name).write_text("\n".join(body) + "\n", encoding="utf-8")
        written.append(f"{relative}/{name}")
    return written


def append_work_artifact(scenario: str, turn: int) -> None:
    with (Path.cwd() / WORK_ARTIFACT).open("a", encoding="utf-8") as fh:
        fh.write(f"{scenario} turn {turn}: fake agent work\n")


def git_commit(turn: int) -> tuple[str | None, str | None]:
    """Author one real commit; return its subject or a diagnostic."""
    subject = f"fake omp: agent work {turn}"
    try:
        subprocess.run(
            ["git", "add", "-A", "--", "."],
            cwd=".", check=True, capture_output=True, text=True)
        result = subprocess.run(
            ["git", "commit", "-m", subject], cwd=".", capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            return None, (result.stderr or result.stdout).strip()
        return subject, None
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)


def ship_draft_text(turn: int) -> str:
    return (
        "<<<COMMIT_MESSAGE>>>\n"
        f"fake omp: squashed agent work (turn {turn})\n\n"
        "Deterministic change authored by the local-test fake omp agent.\n"
        "<<<PR_TITLE>>>\n"
        f"Fake agent work (turn {turn})\n"
        "<<<PR_BODY>>>\n"
        "## Summary\n\nDeterministic fake-omp turn. See the commit history "
        "and `fake-agent-work.txt` for the turn log.\n"
    )


# --- the engine --------------------------------------------------------------

class Engine:
    """One rpc-ui session process."""

    def __init__(self, argv: list[str], resume_id: str | None) -> None:
        self.argv = argv
        self.turn = 0
        self.queued = 0
        self.message_count = 0
        self.last_assistant_text: str | None = None
        self.last_scenario: str | None = None
        self.startup_scenario: str | None = None
        # Remaining entries of the scenario's ordered `results` parameter.
        self.results_queue: str | None = None
        # Every other scenario parameter this run has ever declared.
        self.scenario_params: dict[str, str] = {}
        self.resume_id = resume_id
        self.session_id = resume_id
        self.transcript: Transcript | None = None
        # The native model policy this process was started with, parsed from
        # its own argv so `get_state` can report it back the way real omp
        # does. Recording the auxiliary role flags is what makes a scenario
        # able to assert that all four roles actually reached the child.
        self.model_state: dict[str, str] | None = None
        self.thinking_level: str | None = None
        self.role_flags: dict[str, str] = {}
        self._parse_model_flags(argv)

    def _parse_model_flags(self, argv: list[str]) -> None:
        index = 0
        while index < len(argv):
            flag = argv[index]
            value = argv[index + 1] if index + 1 < len(argv) else ""
            if flag == "--model":
                provider, _, model_id = value.partition("/")
                self.model_state = {"provider": provider, "id": model_id}
                index += 2
            elif flag == "--thinking":
                self.thinking_level = value
                index += 2
            elif flag in ("--smol", "--slow", "--plan"):
                self.role_flags[flag.lstrip("-")] = value
                index += 2
            else:
                index += 1

    # -- launch ---------------------------------------------------------------

    def launch(self) -> None:
        self.startup_scenario = _consume_slot("startup")
        if self.startup_scenario is not None and \
                self.startup_scenario not in STARTUP_SCENARIOS | KNOWN_SCENARIOS:
            die(f"unknown startup scenario {self.startup_scenario!r} in "
                f"control file")

        if self.session_id is None:
            self.session_id = str(uuid.uuid4())
        self.transcript = Transcript(self.session_id)
        self.transcript.append({
            "kind": "launch",
            "argv": self.argv,
            "cwd": str(Path.cwd().resolve()),
            "resume": self.resume_id,
            "pid": os.getpid(),
            "environ": dict(os.environ),
            "startup_scenario": self.startup_scenario,
        })
        scenario = self.startup_scenario
        if scenario == "crash":
            print("Error: No models available", file=sys.stderr, flush=True)
            sys.exit(1)
        if scenario == "silent":
            for _ in sys.stdin:
                pass
            self._exit(0)
            return
        emit({"type": "ready"})
        if scenario == "exit-after-ready":
            self._exit(7)
            return
        if scenario == "ignore-term":
            import signal
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            for _ in sys.stdin:
                pass
            self._exit(0)
            return

        # Resume restores observable context (design D-7).
        for record in self.transcript.load():
            if record.get("kind") == "prompt":
                self.message_count += 2
                text = record.get("assistant_text")
                if isinstance(text, str):
                    self.last_assistant_text = text
                self.turn += 1

        self._main_loop()

    def _exit(self, code: int) -> None:
        if self.transcript is not None:
            self.transcript.append({"kind": "exit", "code": code})
        sys.exit(code)

    # -- main loop ------------------------------------------------------------

    def _main_loop(self) -> None:
        pending_ui: dict | None = None
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                request = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(request, dict):
                continue

            if pending_ui is not None:
                if request.get("type") == "extension_ui_response" and \
                        request.get("id") == pending_ui["ui_id"]:
                    self._ui_finish(pending_ui, request)
                    pending_ui = None
                    continue
                self._handle_generic(request)
                continue

            request_type = request.get("type")
            if request_type in ("follow_up", "abort_and_prompt"):
                request_id = request.get("id", "")
                emit({"id": request_id, "type": "response",
                      "command": request_type, "success": True})
                scenario, params, clean_message = resolve_scenario(
                    request.get("message", ""), self.session_id)
                pending = self._serve_prompt(
                    f"{request_type}-prompt-{request_id}", scenario, params,
                    clean_message)
                if pending is not None:
                    pending_ui = pending
                continue

            if request.get("type") != "prompt":
                self._handle_generic(request)
                continue

            scenario, params, clean_message = resolve_scenario(
                request.get("message", ""), self.session_id)
            pending = self._serve_prompt(
                request.get("id", ""), scenario, params, clean_message)
            if pending is not None:
                pending_ui = pending
        self._exit(0)

    # -- request handling -------------------------------------------------------

    def _handle_generic(self, request: dict) -> None:
        request_id = request.get("id", "")
        rtype = request.get("type")
        if rtype == "set_model":
            # Real omp refuses an unknown model and leaves the active one in
            # place; `unknown-model` reproduces that here.
            if request.get("modelId") == "unknown-model":
                emit({"id": request_id, "type": "response", "command": "set_model",
                      "success": False,
                      "error": f"Model not found: {request.get('provider')}/unknown-model"})
                return
            self.model_state = {
                "provider": request.get("provider"),
                "id": request.get("modelId"),
            }
            emit({"id": request_id, "type": "response", "command": "set_model",
                  "success": True})
            return
        if rtype == "set_thinking_level":
            self.thinking_level = request.get("level")
            emit({"id": request_id, "type": "response",
                  "command": "set_thinking_level", "success": True})
            return
        if rtype == "get_state":
            if self.startup_scenario == "get-state-fails":
                emit({"id": request_id, "type": "response",
                      "command": "get_state", "success": False,
                      "error": "state unavailable"})
            else:
                emit({
                    "id": request_id, "type": "response",
                    "command": "get_state", "success": True,
                    "data": {
                        "isStreaming": False,
                        "isCompacting": False,
                        "queuedMessageCount": self.queued,
                        "messageCount": self.message_count,
                        "sessionId": self.session_id,
                        "contextPercent": 95 if self.last_scenario == "big" else 10,
                        # The native model policy this process was started
                        # with, reported the way real omp does (v18.1.10:
                        # `data.model.{provider,id}` and `thinkingLevel`).
                        # The daemon reads it back and refuses to prompt
                        # unless it matches the accepted policy, so a fake
                        # that ignored the flags would fail every start.
                        "model": self.model_state,
                        "thinkingLevel": self.thinking_level,
                        "roleFlags": self.role_flags,
                    },
                })
            return
        if rtype == "get_session_stats":
            emit({
                "id": request_id, "type": "response",
                "command": "get_session_stats", "success": True,
                "data": {
                    "inputTokens": 1200,
                    "outputTokens": 340,
                    "totalCostUsd": 0.0123,
                    "messageCount": self.message_count,
                },
            })
            return
        if rtype == "get_last_assistant_text":
            # The shape ship.py's draft path is load-bearing on (found by
            # dogfooding: data is an object wrapping "text").
            if self.last_assistant_text is None:
                emit({"id": request_id, "type": "response",
                      "command": "get_last_assistant_text",
                      "success": False, "error": "no assistant message yet"})
            else:
                emit({"id": request_id, "type": "response",
                      "command": "get_last_assistant_text", "success": True,
                      "data": {"text": self.last_assistant_text}})
            return
        if rtype in ("steer", "follow_up", "abort_and_prompt"):
            if request.get("message", "") == "fail":
                emit({"id": request_id, "type": "response",
                      "command": rtype, "success": False, "error": "boom"})
            else:
                emit({"id": request_id, "type": "response",
                      "command": rtype, "success": True})
            return
        emit({"id": request_id, "type": "response",
              "command": rtype, "success": False,
              "error": f"Unknown command: {rtype}"})

    # -- prompt serving ---------------------------------------------------------

    def _serve_prompt(self, request_id: str, scenario: str, params: dict,
                      message: str) -> dict | None:
        """Serve one prompt; returns a pending-ui dict when the scenario
        waits on an extension_ui_response."""
        # Scenario parameters are a property of the run, not of one prompt.
        # Only some steps quote the task prompt that carried them, so they are
        # remembered here — otherwise a later step would silently fall back to
        # defaults the runbook never chose. `results` is the exception that
        # also *shrinks*: it is a queue consumed across the run's steps.
        for key, value in params.items():
            if key != "results":
                self.scenario_params[key] = value
        if "results" in params and self.results_queue is None:
            self.results_queue = params["results"]
        params = {**self.scenario_params, **params}
        if self.results_queue is not None:
            params["results"] = self.results_queue
        self.turn += 1
        self.last_scenario = scenario
        self.current_prompt_message = message
        turn = self.turn
        assistant_text = f"{scenario} turn {turn} complete"

        if scenario == "die":
            self._exit(23)
        if scenario == "fail":
            emit({"id": request_id, "type": "response", "command": "prompt",
                  "success": False, "error": "boom"})
            self._record(scenario, None)
            return None
        if scenario == "ask":
            self.message_count += 2
            pending = self._ask_start(request_id, message)
            self._record(scenario, None)
            return pending
        if scenario == "approve":
            self.message_count += 2
            pending = self._approval_start(request_id, message)
            self._record(scenario, None)
            return pending
        if scenario == "ask-cancel":
            self.message_count += 2
            self._ask_finish(self._ask_start(request_id, message),
                             {"cancelled": True})
            return None
        if scenario == "auto-retry":
            self.message_count += 2
            assistant_text = "retried ok"
            self._retry_prefix(request_id, message, hang=False)
            self._burst_tail(request_id, message, assistant_text)
            self._finish_turn(scenario, assistant_text)
            return None
        if scenario == "auto-retry-hang":
            self.message_count += 2
            self._retry_prefix(request_id, message, hang=True)
            self._record(scenario, None)
            return None
        if scenario == "bad-ask":
            self.message_count += 2
            emit({"id": request_id, "type": "response", "command": "prompt",
                  "success": True})
            emit({"type": "agent_start"})
            emit({"type": "extension_ui_request"})
            emit({"type": "agent_end"})
            return None
        if scenario == "garbage":
            print("this is not json", flush=True)
            emit({"type": "note", "text": "still alive"})
        if scenario == "queue":
            self.queued = 1
        if scenario == "outcome-failed":
            write_outcome(scenario, turn, status="failed")
            assistant_text = f"{scenario} turn {turn} failed"
        elif scenario == "ship-draft":
            assistant_text = ship_draft_text(turn)
        elif scenario == "commit":
            # A real agent edits before committing: author a deterministic
            # change each turn so the commit always has content.
            append_work_artifact(scenario, turn)
            subject, error = git_commit(turn)
            assistant_text = (
                f"committed: {subject}" if subject else f"commit failed: {error}")
        elif scenario == "plan-files":
            written = write_plan_files(turn, params)
            assistant_text = (
                f"wrote planning files (revision {turn}): " + ", ".join(written)
            )
        elif scenario == "no-outcome":
            # A prompted, outcome-bearing step that leaves nothing readable.
            # The engine must stop and say so rather than classify it
            # (ADR-0028); this is the only way to produce that condition
            # without editing daemon state.
            assistant_text = f"{scenario} turn {turn}: no outcome written"
        elif scenario == "review-comments":
            assistant_text = (
                "addressed review comments:\n"
                + "\n".join(
                    f"- fixed: {ln[2:].strip()}"
                    for ln in message.splitlines() if ln.startswith(">"))
            )

        if _OUTCOME_HINT in message and scenario not in {
                "outcome-failed", "no-outcome"}:
            if _RESULT_HINT in message:
                # A format-2 step: satisfy the contract it sent, and declare
                # the result the scenario asked for.
                chosen = write_result(scenario, turn, message, params)
                assistant_text = (
                    f"{scenario} turn {turn}: result {chosen}"
                    if chosen
                    else f"{scenario} turn {turn}: no declared results found")
            else:
                write_outcome(scenario, turn)
                assistant_text = f"{scenario} turn {turn}: outcome written"
            if scenario != "commit":
                append_work_artifact(scenario, turn)

        if "results" in params:
            self.results_queue = params["results"]
        self.message_count += 2
        self._burst(request_id, message, assistant_text,
                    big=scenario == "big", end=scenario != "no-end")
        self._finish_turn(scenario, assistant_text)
        return None

    def _finish_turn(self, scenario: str, assistant_text: str | None) -> None:
        if assistant_text is not None:
            self.last_assistant_text = assistant_text
        self._record(scenario, assistant_text)

    def _record(self, scenario: str, assistant_text: str | None) -> None:
        if self.transcript is not None:
            self.transcript.append({
                "kind": "prompt", "scenario": scenario,
                "message": getattr(self, "current_prompt_message", None),
                "assistant_text": assistant_text,
            })

    # -- recorded frame sequences ---------------------------------------------

    def _burst(self, prompt_id: str, message: str, assistant_text: str,
               big: bool = False, end: bool = True) -> None:
        emit({"type": "extension_ui_request", "id": "1535befcedd1a5c6",
              "method": "setWidget", "widgetKey": "autoresearch"})
        emit({"id": prompt_id, "type": "response", "command": "prompt",
              "success": True})
        emit({"type": "agent_start"})
        emit({"type": "turn_start"})
        user_message = {"role": "user",
                        "content": [{"type": "text", "text": message}]}
        emit({"type": "message_start", "message": user_message})
        emit({"type": "message_end", "message": user_message})
        emit({"type": "message_start",
              "message": {"role": "assistant", "content": []}})
        if big:
            emit({"type": "tool_output", "data": "x" * 200_000})
        assistant_message = {"role": "assistant",
                             "content": [{"type": "text",
                                          "text": assistant_text}]}
        emit({"type": "message_end", "message": assistant_message})
        emit({"type": "turn_end", "message": assistant_message})
        if end:
            emit({"type": "agent_end",
                  "messages": [user_message, assistant_message]})

    def _burst_tail(self, prompt_id: str, message: str,
                    assistant_text: str) -> None:
        emit({"type": "turn_start"})
        user_message = {"role": "user",
                        "content": [{"type": "text", "text": message}]}
        emit({"type": "message_start", "message": user_message})
        emit({"type": "message_end", "message": user_message})
        assistant_message = {"role": "assistant",
                             "content": [{"type": "text",
                                          "text": assistant_text}]}
        emit({"type": "message_start",
              "message": {"role": "assistant", "content": []}})
        emit({"type": "message_end", "message": assistant_message})
        emit({"type": "turn_end", "message": assistant_message})
        emit({"type": "agent_end",
              "messages": [user_message, assistant_message]})

    def _retry_prefix(self, prompt_id: str, message: str, *,
                      hang: bool) -> None:
        emit({"id": prompt_id, "type": "response", "command": "prompt",
              "success": True})
        emit({"type": "agent_start"})
        emit({"type": "auto_retry_start", "attempt": 1, "maxAttempts": 5,
              "delayMs": 40000, "errorMessage": "HTTP 429 from gateway"})
        if not hang:
            emit({"type": "auto_retry_end", "success": True, "attempt": 1})

    def _ask_start(self, prompt_id: str, message: str) -> dict:
        emit({"id": prompt_id, "type": "response", "command": "prompt",
              "success": True})
        emit({"type": "agent_start"})
        emit({"type": "turn_start"})
        user_message = {"role": "user",
                        "content": [{"type": "text", "text": message}]}
        emit({"type": "message_start", "message": user_message})
        emit({"type": "message_end", "message": user_message})
        emit({"type": "extension_ui_request", "id": "ask-ui-1",
              "method": "select",
              "title": "Apply the same lock ordering to the dhcpd6 loop?",
              "options": ["Yes, both loops (Recommended)", "v4 only",
                          "Other (type your own)"]})
        emit({"type": "tool_execution_start", "toolCallId": "toolu_ask1",
              "toolName": "ask",
              "args": {"questions": [{
                  "id": "demo",
                  "question": "Apply the same lock ordering to the dhcpd6 "
                              "loop?",
                  "options": [
                      {"label": "Yes, both loops", "description": "Widen the fix"},
                      {"label": "v4 only",
                       "description": "Match the reproducer"}],
                  "recommended": 0}]},
              "intent": "Demonstrating ask tool"})
        return {"kind": "ask", "ui_id": "ask-ui-1",
                "tool_call_id": "toolu_ask1", "user_message": user_message}

    def _ask_finish(self, pending: dict, reply: dict) -> None:
        emit({"type": "tool_execution_end",
              "toolCallId": pending["tool_call_id"]})
        answer_text = f"got answer: {reply}"
        self._ui_tail(pending, answer_text)

    def _approval_start(self, prompt_id: str, message: str) -> dict:
        emit({"id": prompt_id, "type": "response", "command": "prompt",
              "success": True})
        emit({"type": "agent_start"})
        emit({"type": "turn_start"})
        user_message = {"role": "user",
                        "content": [{"type": "text", "text": message}]}
        emit({"type": "message_start", "message": user_message})
        emit({"type": "message_end", "message": user_message})
        emit({"type": "extension_ui_request", "id": "approval-ui-1",
              "method": "select", "options": ["Approve", "Deny"]})
        return {"kind": "approval", "ui_id": "approval-ui-1",
                "user_message": user_message}

    def _ui_finish(self, pending: dict, reply: dict) -> None:
        if pending["kind"] == "ask":
            self._ask_finish(pending, reply)
        else:
            self._ui_tail(pending, f"got answer: {reply}")

    def _ui_tail(self, pending: dict, answer_text: str) -> None:
        assistant_message = {"role": "assistant",
                             "content": [{"type": "text",
                                          "text": answer_text}]}
        emit({"type": "message_start",
              "message": {"role": "assistant", "content": []}})
        emit({"type": "message_end", "message": assistant_message})
        emit({"type": "turn_end", "message": assistant_message})
        emit({"type": "agent_end",
              "messages": [pending["user_message"], assistant_message]})
        self.last_assistant_text = answer_text
        self._record(f"{pending['kind']}-reply", answer_text)


# --- scenario resolution (design D-3) ----------------------------------------

def resolve_scenario(message: str,
                     session_id: str | None = None) -> tuple[str, dict, str]:
    """Returns (scenario, params, message-without-directive-lines)."""
    scenario: str | None = None
    params: dict[str, str] = {}
    clean_lines: list[str] = []
    for line in message.splitlines():
        # Directives are stripped per line, and a line may carry several: a
        # runbook writing "\n" inside double quotes gets one physical line,
        # and taking only the first marker there would silently drop the rest
        # — a scenario would then run with parameters nobody applied.
        match = _SCENARIO_RE.search(line)
        pairs = _PARAM_RE.findall(line)
        for key, value in pairs:
            params[key] = value
        if match and scenario is None:
            scenario = match.group(1)
        if match or pairs:
            # Keep whatever prose shared the line with the directives.
            remainder = _PARAM_RE.sub("", _SCENARIO_RE.sub("", line)).strip()
            if remainder:
                clean_lines.append(remainder)
            continue
        clean_lines.append(line)
    clean_message = "\n".join(clean_lines)

    if scenario is None:
        scenario = _consume_slot("next_prompt", session_id)
    if scenario is None:
        scenario = classify_prompt(clean_message)
    return scenario, params, clean_message


def classify_prompt(message: str) -> str:
    if all(marker in message for marker in _DRAFT_MARKERS):
        return "ship-draft"
    if message.startswith(_NUDGE_PREFIX):
        return "resume-nudge"
    if message.startswith(_RETRY_PREFIX):
        return "retry-prefix"
    lines = [ln for ln in message.splitlines() if ln.strip()]
    if message.startswith(_REVIEW_PREFIX) and any(
            ln.lstrip().startswith(">") for ln in lines):
        return "review-comments"
    return "happy"


# --- argv dispatch (design D-2) ----------------------------------------------

def main() -> None:
    argv = sys.argv[1:]
    if argv == ["config", "get", "ask.timeout"]:
        print("0")
        return
    if argv == ["scenarios"]:
        print("behavior:")
        for name in sorted(KNOWN_SCENARIOS - STARTUP_SCENARIOS):
            print(f"  {name}")
        print("startup-only:")
        for name in sorted(STARTUP_SCENARIOS):
            print(f"  {name}")
        return
    if argv == ["--version"]:
        print(f"omp/{CAPTURED_VERSION} (fake, local-test)")
        return
    if argv == ["selfcheck"]:
        selfcheck()
        return

    if argv and argv[0] == "--mode" and len(argv) >= 2 and argv[1] == "rpc-ui":
        resume: str | None = None
        i = 2
        while i < len(argv):
            flag = argv[i]
            if flag == "--no-title":
                i += 1
            elif flag in ("--model", "--thinking", "--smol", "--slow", "--plan") and i + 1 < len(argv):
                i += 2
            elif flag == "--resume" and i + 1 < len(argv):
                resume = argv[i + 1]
                i += 2
            else:
                unsupported(argv)
        engine = Engine(argv, resume)
        engine.launch()
        return

    unsupported(argv)


# --- selfcheck (design D-8) --------------------------------------------------

def selfcheck() -> None:
    import shutil

    failures = 0
    total = 0

    def check(name: str, ok: bool, detail: str = "") -> None:
        nonlocal failures, total
        total += 1
        if ok:
            print(f"  ok    {total:2d}  {name}")
        else:
            failures += 1
            print(f"  FAIL  {total:2d}  {name}" +
                  (f" — {detail}" if detail else ""))

    self_bin = os.path.abspath(__file__)
    workdir = Path(tempfile.mkdtemp(prefix="omp-selfcheck-"))
    original_state = os.environ.get("LOCAL_TEST_STATE")
    try:
        state = workdir / "state"
        clone = workdir / "clone"
        state.mkdir()
        clone.mkdir()
        os.environ["LOCAL_TEST_STATE"] = str(state)

        def run(args: list[str], stdin: str | None = None,
                cwd: Path | None = None) -> subprocess.CompletedProcess:
            return subprocess.run(
                [sys.executable, self_bin, *args],
                input=stdin, capture_output=True, text=True,
                cwd=str(cwd or clone), timeout=30)

        def session(scenario_arm: dict | None = None,
                    cwd_dir: Path | None = None,
                    extra_args: list[str] | None = None) -> subprocess.Popen:
            if scenario_arm is not None:
                slot, key, value = scenario_arm["slot"], \
                    scenario_arm["key"], scenario_arm["value"]
                doc = {"startup": {}, "next_prompt": {}}
                doc[slot][key] = value
                _atomic_write(state / "omp-scenarios.json",
                              json.dumps(doc))
            return subprocess.Popen(
                [sys.executable, self_bin, "--mode", "rpc-ui",
                 "--no-title", *(extra_args or [])],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, text=True,
                cwd=str(cwd_dir or clone))

        def send(proc: subprocess.Popen, obj: dict) -> None:
            assert proc.stdin is not None
            proc.stdin.write(json.dumps(obj) + "\n")
            proc.stdin.flush()


        def send_prompt(proc: subprocess.Popen, message: str,
                        request_id: str = "r1") -> None:
            send(proc, {"id": request_id, "type": "prompt",
                        "message": message})

        # 1. preflight
        r = run(["config", "get", "ask.timeout"])
        check("ask-timeout preflight prints 0",
              r.returncode == 0 and r.stdout.strip() == "0", r.stdout.strip())

        def read_frames(proc: subprocess.Popen, count: int,
                        timeout: float = 10.0) -> list[dict]:
            """Raw-read drain with a deadline. A select() loop over the
            TextIOWrapper races Python's read-ahead buffering (a fully
            buffered burst leaves the fd quiet while lines sit unread),
            and a bare readline() blocks past the deadline; os.read into
            a line buffer avoids both."""
            import select as _select
            import time
            frames: list[dict] = []
            buf = ""
            deadline = time.monotonic() + timeout
            fd = proc.stdout.fileno()
            while len(frames) < count and time.monotonic() < deadline:
                ready, _, _ = _select.select([proc.stdout], [], [],
                                             max(0.0, deadline - time.monotonic()))
                if not ready:
                    continue
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                buf += chunk.decode("utf-8", "replace")
                while "\n" in buf and len(frames) < count:
                    line, buf = buf.split("\n", 1)
                    if not line:
                        continue
                    try:
                        frames.append(json.loads(line))
                    except json.JSONDecodeError:
                        frames.append({"__raw__": line})
            return frames
        # 2. ready + get_state
        p = session()
        frames = read_frames(p, 1)
        check("ready frame emitted", bool(frames) and
              frames[0].get("type") == "ready")
        send(p, {"id": "s1", "type": "get_state"})
        frames = read_frames(p, 1)
        sid = frames[0].get("data", {}).get("sessionId", "") \
            if frames and frames[0].get("success") else ""
        check("get_state reports a session id", bool(sid))

        # 3. happy turn with outcome instruction
        outcome_prompt = ("Do the work.\n\nWhen you have finished the work "
                          "above, write your result as JSON to "
                          "`.ompire/outcome.json` with exactly this schema.")
        send_prompt(p, outcome_prompt, "r1")
        frames = read_frames(p, 10)
        types = [f.get("type") for f in frames]
        check("prompt acked", any(
            f.get("type") == "response" and f.get("command") == "prompt"
            and f.get("success") for f in frames))
        check("burst ends in agent_end", "agent_end" in types)
        outcome_file = clone / OUTCOME_PATH
        try:
            outcome = json.loads(outcome_file.read_text())
        except (OSError, json.JSONDecodeError):
            outcome = {}
        check("outcome file valid",
              outcome.get("version") == 1 and
              outcome.get("status") == "success" and
              isinstance(outcome.get("summary"), str))
        check("work artifact appended",
              (clone / WORK_ARTIFACT).exists())

        # 4. get_last_assistant_text
        send(p, {"id": "s2", "type": "get_session_stats"})
        frames = read_frames(p, 1)
        check("get_session_stats shape", frames and
              frames[0].get("success") and
              isinstance(frames[0].get("data", {}).get("messageCount"), int))
        send(p, {"id": "s3", "type": "get_last_assistant_text"})
        frames = read_frames(p, 1)
        check("get_last_assistant_text returns emitted text",
              frames and frames[0].get("success") and
              isinstance(frames[0].get("data", {}).get("text"), str))

        # 5. directive scenarios (fresh process so turn state is clean)
        p.terminate(); p.wait()
        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:ask]]\nplease?", "r1")
        frames = read_frames(p, 8)
        ui = next((f for f in frames if
                   f.get("type") == "extension_ui_request"), None)
        check("ask scenario raises a question", ui is not None)
        if ui is not None:
            send(p, {"type": "extension_ui_response", "id": ui["id"],
                     "value": "Yes, both loops"})
            frames = read_frames(p, 5)
            check("ask reply completes the turn", any(
                f.get("type") == "agent_end" for f in frames))

        p.terminate(); p.wait()
        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:no-end]]\nwork", "r1")
        frames = read_frames(p, 9)
        check("no-end burst lacks agent_end",
              not any(f.get("type") == "agent_end" for f in frames))
        p.terminate(); p.wait()

        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:die]]\nwork", "r1")
        p.wait(timeout=10)
        check("die exits 23", p.returncode == 23)

        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:garbage]]\nwork", "r1")
        frames = read_frames(p, 12)
        check("garbage emits an unparseable line", any(
            "__raw__" in f for f in frames))

        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:queue]]\nwork", "r1")
        read_frames(p, 10)
        send(p, {"id": "q1", "type": "get_state"})
        frames = read_frames(p, 1)
        check("queue reports queuedMessageCount 1", frames and
              frames[0].get("data", {}).get("queuedMessageCount") == 1)
        p.terminate(); p.wait()

        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:outcome-failed]]\n" + outcome_prompt, "r1")
        read_frames(p, 10)
        try:
            outcome = json.loads((clone / OUTCOME_PATH).read_text())
        except (OSError, json.JSONDecodeError):
            outcome = {}
        check("outcome-failed writes status failed",
              outcome.get("status") == "failed")
        p.terminate(); p.wait()

        # A prompted, outcome-bearing step that leaves nothing readable —
        # the condition the engine must stop on rather than classify.
        (clone / OUTCOME_PATH).unlink(missing_ok=True)
        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:no-outcome]]\nwork, and write "
                       + _OUTCOME_HINT, "r1")
        read_frames(p, 10)
        check("no-outcome leaves no outcome file",
              not (clone / OUTCOME_PATH).exists())
        p.terminate(); p.wait()

        # git commit scenario (real repo)
        r = subprocess.run(["git", "init", "-q"], cwd=str(clone))
        subprocess.run(["git", "config", "user.email",
                        "fake@local-test"], cwd=str(clone), check=True)
        subprocess.run(["git", "config", "user.name",
                        "fake omp"], cwd=str(clone), check=True)
        (clone / "new-file.txt").write_text("work\n")
        p = session()
        read_frames(p, 1)
        send_prompt(p, "[[scenario:commit]]\n" + outcome_prompt, "r1")
        read_frames(p, 10)
        log = subprocess.run(["git", "log", "--oneline"], cwd=str(clone),
                             capture_output=True, text=True)
        check("commit scenario creates a real commit",
              "agent work" in log.stdout)
        p.terminate(); p.wait()

        # 6. classification from verbatim daemon prompts
        draft_prompt = """You are helping the operator ship this task.

Please propose:
1. A concise commit message for the final squash commit.
2. A PR title.
3. A PR body.

Format your reply as:

<<<COMMIT_MESSAGE>>>
<the commit message>

<<<PR_TITLE>>>
<the PR title>

<<<PR_BODY>>>
<the PR body>
"""
        p = session()
        read_frames(p, 1)
        send_prompt(p, draft_prompt, "r1")
        read_frames(p, 10)
        send(p, {"id": "g1", "type": "get_last_assistant_text"})
        frames = read_frames(p, 1)
        text = frames[0].get("data", {}).get("text", "") if frames else ""
        parsed = _parse_draft(text)
        check("ship draft classified and parseable",
              parsed is not None and all(parsed),
              text[:60])
        p.terminate(); p.wait()

        # An operator-authorized retry after an uncertainty pause carries the
        # daemon's retry preamble, and is classified apart from the restart
        # nudge: one says "continue", the other says "inspect first".
        retry_prompt = ("Your previous attempt at this step finished without "
                        "leaving a valid result, so an operator asked for "
                        "another attempt. The original instruction follows.\n\n"
                        "do the thing")
        p = session()
        read_frames(p, 1)
        send_prompt(p, retry_prompt, "r1")
        read_frames(p, 10)
        send(p, {"id": "g1", "type": "get_last_assistant_text"})
        frames = read_frames(p, 1)
        text = frames[0].get("data", {}).get("text", "") if frames else ""
        check("retry preamble classified apart from the restart nudge",
              text.startswith("retry-prefix"), text[:60])
        p.terminate(); p.wait()

        p = session()
        read_frames(p, 1)
        send_prompt(p, "The daemon restarted while you were working; please "
                       "continue.", "r1")
        frames = read_frames(p, 10)
        check("resume nudge classified", any(
            f.get("type") == "agent_end" for f in frames))
        p.terminate(); p.wait()

        p = session()
        read_frames(p, 1)
        send_prompt(p, 'Review comments:\n"> Please fix the thing"\n'
                       '"> Also the other thing"', "r1")
        frames = read_frames(p, 10)
        check("review comments classified", any(
            f.get("type") == "agent_end" for f in frames))
        p.terminate(); p.wait()

        # 7. control file arming
        _atomic_write(state / "omp-scenarios.json", json.dumps(
            {"startup": {}, "next_prompt": {str(clone.resolve()): "big"}}))
        p = session()
        read_frames(p, 1)
        send_prompt(p, "plain work", "r1")
        frames = read_frames(p, 11)
        check("clone-keyed armed scenario fires", any(
            f.get("type") == "tool_output" and
            len(str(f.get("data", ""))) > 100_000 for f in frames))
        p.terminate(); p.wait()

        _atomic_write(state / "omp-scenarios.json", json.dumps(
            {"startup": {}, "next_prompt": {"global": "outcome-failed"}}))
        p = session()
        read_frames(p, 1)
        send_prompt(p, "plain work", "r1")
        read_frames(p, 10)
        try:
            outcome = json.loads((clone / OUTCOME_PATH).read_text())
        except (OSError, json.JSONDecodeError):
            outcome = {}
        check("global armed scenario fires once", outcome.get("status")
              == "failed")
        p.terminate(); p.wait()

        control_now = json.loads(
            (state / "omp-scenarios.json").read_text())
        check("armed entry consumed", control_now.get("next_prompt", {})
              .get("global") is None)

        p = session({"slot": "startup", "key": "global", "value": "crash"})
        _, err = p.communicate(timeout=10)
        check("startup crash exits 1 pre-ready",
              p.returncode == 1 and "No models available" in err)

        p = session({"slot": "startup", "key": "global",
                     "value": "exit-after-ready"})
        read_frames(p, 1)
        p.wait(timeout=10)
        # 7b. session-keyed arming + launch pid + scenarios verb (Part 8)
        p = session()
        read_frames(p, 1)
        send(p, {"id": "sk0", "type": "get_state"})
        frames = read_frames(p, 1)
        sid = frames[0].get("data", {}).get("sessionId", "")
        _atomic_write(state / "omp-scenarios.json", json.dumps(
            {"startup": {}, "next_prompt": {sid: "queue"}}))
        import time as _time

        def drain_until(proc: subprocess.Popen, predicate,
                        timeout: float = 10.0) -> list[dict]:
            """readline-drain (immune to the select/read-ahead race that
            makes read_frames return early when a burst is fully
            buffered): collect frames until one matches."""
            got: list[dict] = []
            deadline = _time.monotonic() + timeout
            while _time.monotonic() < deadline:
                line = proc.stdout.readline()
                if not line:
                    break
                try:
                    frame = json.loads(line)
                except json.JSONDecodeError:
                    continue
                got.append(frame)
                if predicate(frame):
                    return got
            return got

        send_prompt(p, "plain work", "r1")
        send(p, {"id": "q2", "type": "get_state"})
        frames = drain_until(p, lambda f: f.get("id") == "q2")
        q2 = next((f for f in frames if f.get("id") == "q2"), None)
        check("session-keyed armed scenario fires",
              q2 is not None and
              q2.get("data", {}).get("queuedMessageCount") == 1)
        p.terminate(); p.wait()

        _atomic_write(state / "omp-scenarios.json", json.dumps(
            {"startup": {}, "next_prompt": {sid: "big"}}))
        p = session()  # different session: must NOT consume sid's entry
        read_frames(p, 1)
        send_prompt(p, "plain work", "r1")
        frames = drain_until(p, lambda f: f.get("type") == "agent_end")
        check("session key leaves other sessions alone",
              not any(f.get("type") == "tool_output" and
                      len(str(f.get("data", ""))) > 100_000
                      for f in frames))
        p.terminate(); p.wait()

        launch_records = []
        for line in (state / "omp-sessions" / f"{sid}.jsonl").read_text() \
                .splitlines():
            record = json.loads(line)
            if record.get("kind") == "launch":
                launch_records.append(record)
        check("launch record carries a pid",
              launch_records and isinstance(launch_records[0].get("pid"), int))

        r = run(["scenarios"])
        check("scenarios verb lists the catalog",
              r.returncode == 0 and "startup-only:" in r.stdout
              and "ship-draft" in r.stdout)

        # 8. resume
        p = session()
        read_frames(p, 1)
        send(p, {"id": "rs1", "type": "get_state"})
        frames = read_frames(p, 1)
        sid = frames[0].get("data", {}).get("sessionId", "")
        send_prompt(p, "[[scenario:ship-draft]]\ndraft", "r1")
        read_frames(p, 10)
        send(p, {"id": "rs2", "type": "get_last_assistant_text"})
        frames = read_frames(p, 1)
        pre_text = frames[0].get("data", {}).get("text", "")
        p.kill(); p.wait()

        p = session(extra_args=["--resume", sid])
        read_frames(p, 1)
        send(p, {"id": "rs3", "type": "get_state"})
        frames = read_frames(p, 1)
        data = frames[0].get("data", {})
        check("resume preserves session id",
              data.get("sessionId") == sid)
        check("resume restores message count",
              data.get("messageCount") == 2)
        send(p, {"id": "rs4", "type": "get_last_assistant_text"})
        frames = read_frames(p, 1)
        check("resume restores last assistant text",
              frames[0].get("data", {}).get("text") == pre_text)
        p.terminate(); p.wait()

        # 9. loud rejection
        r = run(["run", "-p", "."])
        check("unsupported invocation rejected loudly",
              r.returncode != 0 and "unsupported invocation" in r.stderr)
        r = run(["--version"])
        check("version banner carries fake marker",
              r.returncode == 0 and "fake, local-test" in r.stdout)

        # 10. persistent state root untouched
        check("persistent state root untouched",
              not (workdir / "persistent-marker").exists())
    finally:
        os.environ.pop("LOCAL_TEST_STATE", None)
        if original_state is not None:
            os.environ["LOCAL_TEST_STATE"] = original_state
        shutil.rmtree(workdir, ignore_errors=True)

    if failures:
        print(f"\n{failures}/{total} checks FAILED")
        sys.exit(1)
    print(f"\nall {total} checks passed")


def _parse_draft(text: str) -> tuple[str, str, str] | None:
    """Mirror of ship._parse_draft (three non-empty sections)."""
    markers = ["<<<COMMIT_MESSAGE>>>", "<<<PR_TITLE>>>", "<<<PR_BODY>>>"]
    sections: dict[str, str] = {}
    for i, marker in enumerate(markers):
        idx = text.find(marker)
        if idx < 0:
            return None
        start = idx + len(marker)
        next_marker = markers[i + 1] if i + 1 < len(markers) else None
        end = text.find(next_marker, start) if next_marker else len(text)
        if end < 0:
            return None
        sections[marker] = text[start:end].strip()
    return (sections["<<<COMMIT_MESSAGE>>>"], sections["<<<PR_TITLE>>>"],
            sections["<<<PR_BODY>>>"])


