#!/usr/bin/env bash
#
# local-test/scenarios/ship-retain — LOCAL-TESTING.PLAN.md Part 9, flow 4.
#
# Retain mode: build a multi-commit agent history in the task clone (the
# fake omp's `commit` scenario authors real git commits via follow-up
# prompts), publish it in retain mode, and assert the rewrite contract —
# commit count preserved and every commit re-signed with the ephemeral key.
#
# Retain is a mode an *author* declares on a commit action, so this scenario
# authors the workflow it needs, exactly as an operator would: work, a gate
# that waits while the history is built, review, and an approval whose one
# publishing answer authorizes a retain commit, a push, and a pull request.

set -euo pipefail
. "$(dirname "$0")/lib.sh"


 

BARE=$STATE_ROOT/forge/github.com/local-test/sandbox.git
AGENT_COMMITS=2
WORKFLOW=retain-flow

RETAIN_YAML=$(cat "$(dirname "$0")/retain-flow.yaml")

ws_start
_agent_idle_after() { # _agent_idle_after TASK PREVIOUS_IDLE_EVENTS
	[ "$(ws_count '.type == "status_changed" and .payload.task_id == '"$1"' and .payload.session == "main" and .payload.to == "idle"')" -gt "$2" ]
}

save_workflow "$WORKFLOW" "$RETAIN_YAML"
tid=$(spawn_task "$(unique_slug retain)" "Retain-mode E2E: do the initial work." "$WORKFLOW")
wait_for "the run waits while history is built" 180 workflow_gate "$tid" >/dev/null

# --- agent history: one commit per follow-up ---------------------------------

clone=$(task_field "$tid" clone_path)
for i in $(seq 1 "$AGENT_COMMITS"); do
	idle_events=$(ws_count '.type == "status_changed" and .payload.task_id == '"$tid"' and .payload.session == "main" and .payload.to == "idle"')
	follow_up "$tid" "[[scenario:commit]]
Agent change $i: stage and commit."
	# The commit can land just before session state returns idle. The draft route
	# requires that latter observable state, so wait for both boundaries.
	wait_for "agent commit $i lands in the clone" 60 _clone_commits "$clone" "$i"
	wait_for "agent commit $i returns the primary session idle" 60 _agent_idle_after "$tid" "$idle_events"
done
ok "$AGENT_COMMITS agent commits authored"

# --- retain ship ---------------------------------------------------------------

answer_gate "$tid" continue
approve_run_review "$tid"
wait_for "the run reaches its publication decision" 180 at_approval "$tid"
message="ship: retained history"
pr_title="Retained history"
pr_body="each commit kept"
$GPGCTL warm

# The preview reports the range it would retain before anything is signed.
ship_preview "$tid" open-pr "retain-$tid" "$message" "$pr_title" "$pr_body"
[ "$API_CODE" = 200 ] || die "retain preview rejected ($API_CODE): $(cat /tmp/ship-preview-$tid.json)"
jq -e --argjson n "$AGENT_COMMITS" '.deliverable and .candidate.commit_count == $n' \
	/tmp/ship-preview-$tid.json >/dev/null &&
	ok "preview names the $AGENT_COMMITS commits retain would publish" ||
	fail "retain preview range" "$(jq -c '{deliverable, candidate, blockers}' /tmp/ship-preview-$tid.json)"

ship_deliver "$tid" open-pr "$message" "$pr_title" "$pr_body"
wait_for "retain delivery finishes" 120 ship_done "$tid" pr
[ "$(ship_field "$tid" '.results.commit.commit_count')" = "$AGENT_COMMITS" ] &&
	ok "the recorded result keeps the retained commit count" ||
	fail "recorded retain count" "$(ship_field "$tid" '.results.commit')"

# --- assertions -----------------------------------------------------------------

branch=$(task_field "$tid" branch)
scratch_clone "$BARE" scratch
# origin/main..origin/<branch> in a normal clone is the retained,
# rewritten, re-signed history visible to downstream consumers.
count=$(forge_git -C "$scratch" rev-list --count "origin/main..origin/$branch")
[ "$count" = "$AGENT_COMMITS" ] &&
	ok "commit count preserved ($count == $AGENT_COMMITS)" ||
	fail "commit count preserved" "got $count, want $AGENT_COMMITS"

verified=0
for sha in $(forge_git -C "$scratch" rev-list "origin/main..origin/$branch"); do
	forge_git -C "$scratch" verify-commit "$sha" >/dev/null 2>&1 && verified=$((verified + 1))
done
[ "$verified" = "$AGENT_COMMITS" ] &&
	ok "every retained commit signature verifies ($verified/$AGENT_COMMITS)" ||
	fail "retained commits verified" "only $verified/$AGENT_COMMITS verify"

assert "task never failed" task_not_failed "$tid"
ok "PR: $(task_field "$tid" pr_url)"
