#!/usr/bin/env bash
#
# local-test/scenarios/ship-failures — publishing failures recover safely.
#
# GitHub authentication and repository eligibility are checked before GPG or
# any local Git mutation. The runbook captures the clone baseline, injects
# credential-shaped fake CLI output, proves the safe 409/event surface, then
# restores access and continues through existing GPG, PR, push, and retain
# recovery legs.

set -euo pipefail
. "$(dirname "$0")/lib.sh"

ws_start

_ship_error() { # _ship_error TASK SUBSTRING — a failed ship_step whose
	# detail names SUBSTRING is recorded for TASK
	local lines
	lines=$(jq -c "select(.type == \"ship_step\" and .payload.status == \"failed\" and .payload.task_id == $1)" "$WS_OUT" 2>/dev/null) || true
	[ -n "$lines" ] || { printf 'no failed ship_step recorded'; return 1; }
	grep -F "$2" <<<"$lines" >/dev/null && printf 'ship error names %s' "$2" || {
		printf 'ship error detail lacks %q\n%s' "$2" "$lines"; return 1; }
}
_ship_shipped() { # _ship_shipped TASK WANT_COUNT
	[ "$(ws_count '.type == "ship_finished" and .payload.status == "shipped" and .payload.task_id == '"$1"'')" -ge "$2" ]
}
_clone_commits() { # _clone_commits CLONE WANT
	local n
	n=$(git -C "$1" rev-list --count origin/main..HEAD 2>/dev/null) || { printf 'no origin/main'; return 1; }
	[ "$n" = "$2" ] && printf '%s' "$n" || { printf 'commits=%s want=%s' "$n" "$2"; return 1; }
}
ship_body() { # ship_body MODE MESSAGE
	jq -n --arg m "$2" --arg mode "$1" '{message: $m, pr_title: "Failure paths", pr_body: "b", mode: $mode}'
}
_clone_unchanged() { # _clone_unchanged CLONE HEAD STATUS
	local clone=$1 expected_head=$2 expected_status=$3
	[ "$(git -C "$clone" rev-parse HEAD)" = "$expected_head" ] || {
		printf 'HEAD changed: %s' "$(git -C "$clone" rev-parse HEAD)"; return 1; }
	[ "$(git -C "$clone" status --porcelain)" = "$expected_status" ] || {
		printf 'worktree changed'; return 1; }
	if git -C "$clone" rev-parse --verify refs/ompire/ship-orig >/dev/null 2>&1; then
		printf 'ship restore ref was created'; return 1
	fi
}
_no_commit_started() { # _no_commit_started TASK
	[ "$(ws_count '.type == "ship_step" and .payload.task_id == '"$1"' and .payload.step == "commit"')" = 0 ]
}

tid=$(spawn_task "$(unique_slug fail)" "[[scenario:commit]]\nShip-failures E2E: do the work and commit it.")
wait_for "work step completes" 180 workflow_complete "$tid"
clone=$(task_field "$tid" clone_path)
baseline_head=$(git -C "$clone" rev-parse HEAD)
baseline_status=$(git -C "$clone" status --porcelain)

# --- leg 1: invalid ambient auth is redacted and cannot touch Git ------------
$GHCTL auth unauthenticated >/dev/null
$GHCTL token-echo stderr >/dev/null
_api_run POST "/api/tasks/$tid/ship/commit" "$(ship_body squash gh-auth-blocked)"
body=$API_BODY
fake_token='github_pat_LOCAL_TEST_TOKEN_ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
[ "$API_CODE" = 409 ] && jq -e '.detail.gh.identity.state == "unauthenticated"' <<<"$body" >/dev/null &&
	ok "GitHub auth preflight refused with safe 409" ||
	fail "GitHub auth preflight refusal" "code $API_CODE: $body"
assert "auth-blocked clone remains unchanged" _clone_unchanged "$clone" "$baseline_head" "$baseline_status"
assert "auth-blocked ship emits no commit start" _no_commit_started "$tid"
if grep -F "$fake_token" "$WS_OUT" >/dev/null 2>&1 || grep -Fi 'Authorization: Bearer' "$WS_OUT" >/dev/null 2>&1; then
	fail "GitHub preflight redaction" "credential-shaped fake output reached WebSocket recording"
else
	ok "GitHub preflight status and WebSocket recording are redacted"
fi
$GHCTL token-echo off >/dev/null
$GHCTL auth login ompire-test >/dev/null

# --- leg 2: repository denial is pre-mutation and recovers -------------------
$GHCTL repository deny >/dev/null
_api_run POST "/api/tasks/$tid/ship/commit" "$(ship_body squash gh-repository-denied)"
body=$API_BODY
[ "$API_CODE" = 409 ] && jq -e '.detail.gh.targets["github.com/local-test/sandbox"].state == "denied"' <<<"$body" >/dev/null &&
	ok "GitHub repository preflight refused with 409" ||
	fail "GitHub repository preflight refusal" "code $API_CODE: $body"
assert "denied-repository clone remains unchanged" _clone_unchanged "$clone" "$baseline_head" "$baseline_status"
assert "denied-repository ship emits no commit start" _no_commit_started "$tid"
$GHCTL repository allow >/dev/null

# --- leg 3: locked GPG gate refuses with 409, warm recovers ------------------
$GPGCTL lock
_api_run POST "/api/tasks/$tid/ship/commit" "$(ship_body squash fail-1)"
body=$API_BODY
[ "$API_CODE" = 409 ] && jq -e '.detail.message == "GPG signing key is not cached"' <<<"$body" >/dev/null &&
	ok "locked gate refused with 409 + gate message" ||
	fail "locked gate refusal" "code $API_CODE: $body"
$GPGCTL warm
api_json POST /api/gpg/recheck >/dev/null
[ "$(jq -r .state <<<"$API_BODY")" = cached ] &&
	ok "recheck says cached after warm" ||
	fail "gpg recheck after warm" "$API_BODY"
# --- leg 4: injected gh create failure → ship error → retry ships --------------

$GHCTL fail-next create >/dev/null
api POST "/api/tasks/$tid/ship/commit" "$(ship_body squash fail-gh)" >/dev/null
[ "$API_CODE" = 200 ] || die "ship commit (gh-fail leg) rejected ($API_CODE)"
wait_for "gh failure lands as ship error" 120 _ship_error "$tid" "injected create failure"
ok "injected gh failure surfaced in ship error"
api POST "/api/tasks/$tid/ship/commit" "$(ship_body squash fail-gh-retry)" >/dev/null
[ "$API_CODE" = 200 ] || die "ship retry rejected ($API_CODE)"
wait_for "retry ships after gh failure" 120 _ship_shipped "$tid" 1
ok "recovered: shipped after gh failure"

# --- leg 5: forge rejects exactly one push -------------------------------------

$FORGE reject-push local-test/sandbox >/dev/null
api POST "/api/tasks/$tid/ship/commit" "$(ship_body squash pushfail)" >/dev/null
[ "$API_CODE" = 200 ] || die "ship commit (push-fail leg) rejected ($API_CODE)"
wait_for "push rejection lands as ship error" 120 _ship_error "$tid" "forge: rejecting push"
ok "forge rejection surfaced in ship error"
api POST "/api/tasks/$tid/ship/commit" "$(ship_body squash pushfail-retry)" >/dev/null
[ "$API_CODE" = 200 ] || die "push retry rejected ($API_CODE)"
wait_for "retry ships after push rejection" 120 _ship_shipped "$tid" 2
ok "recovered: shipped after push rejection"

# --- leg 6: retain mode refuses a dirty tree -----------------------------------

follow_up "$tid" "[[scenario:commit]]
One commit so retain has something to retain."
clone=$(task_field "$tid" clone_path)
wait_for "agent commit lands" 60 _clone_commits "$clone" 2
echo "stray" >"$clone/uncommitted.txt"
_api_run POST "/api/tasks/$tid/ship/commit" "$(ship_body retain dirty)"
body=$API_BODY
[ "$API_CODE" = 409 ] && grep -q "working tree is dirty" <<<"$body" &&
	ok "retain refused dirty tree with 409" ||
	fail "dirty-tree refusal" "code $API_CODE: $body"
rm -f "$clone/uncommitted.txt"
$GPGCTL warm
api POST "/api/tasks/$tid/ship/commit" "$(ship_body retain dirty-recovered)" >/dev/null
[ "$API_CODE" = 200 ] || die "retain retry rejected ($API_CODE)"
wait_for "retain ships after cleanup" 120 _ship_shipped "$tid" 3
ok "recovered: retain shipped after tree cleaned"

# --- final agreement ------------------------------------------------------------

assert "task $tid never failed" task_not_failed "$tid"
[ -n "$(task_field "$tid" pr_url)" ] && ok "task retains its PR URL" ||
	fail "task PR URL" "missing after recovery phases"
