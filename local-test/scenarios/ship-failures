#!/usr/bin/env bash
#
# local-test/scenarios/ship-failures — refusals happen before any effect, and
# every one of them recovers.
#
# Admission is resolved by a read-only preview now (ADR-0032): the operator is
# told every reason a delivery is refused before anything is signed, pushed, or
# created. This runbook proves each refusal names itself, leaves the workspace
# untouched, and clears once its cause is fixed.

set -euo pipefail
. "$(dirname "$0")/lib.sh"

ws_start

BARE=$STATE_ROOT/forge/github.com/local-test/sandbox.git

_blockers() { # _blockers TASK — the codes the last preview reported
	jq -r '[.blockers[].code] | join(",")' "/tmp/ship-preview-$1.json"
}
_has_blocker() { # _has_blocker TASK CODE
	jq -e --arg c "$2" '[.blockers[].code] | index($c)' "/tmp/ship-preview-$1.json" >/dev/null
}
_clone_unchanged() { # _clone_unchanged CLONE HEAD STATUS
	local clone=$1 expected_head=$2 expected_status=$3
	[ "$(git -C "$clone" rev-parse HEAD)" = "$expected_head" ] || {
		printf 'HEAD changed: %s' "$(git -C "$clone" rev-parse HEAD)"; return 1; }
	[ "$(git -C "$clone" status --porcelain)" = "$expected_status" ] || {
		printf 'worktree changed'; return 1; }
}
_no_action_started() { # _no_action_started TASK
	local payload
	payload=$(ship_projection "$1")
	[ -z "$payload" ] && return 0
	[ "$(jq -r '.actions | length' <<<"$payload")" = 0 ]
}

tid=$(spawn_task "$(unique_slug fail)" "[[scenario:commit]]\nShip-failures E2E: do the work and commit it.")
wait_for "work step completes" 180 workflow_complete "$tid"
clone=$(task_field "$tid" clone_path)
baseline_head=$(git -C "$clone" rev-parse HEAD)
baseline_status=$(git -C "$clone" status --porcelain)

# --- leg 1: no approved review is a refusal that says so ----------------------

ship_preview "$tid" pr squash "no-review-$tid" "m" "t" "b"
[ "$API_CODE" = 200 ] || die "preview request failed ($API_CODE)"
_has_blocker "$tid" review-missing &&
	ok "an unreviewed task is refused by name (blockers: $(_blockers "$tid"))" ||
	fail "unreviewed refusal" "$(_blockers "$tid")"
assert "unreviewed preview started no action" _no_action_started "$tid"

approve_review "$tid"

# --- leg 2: invalid ambient auth blocks a pushing ending, not a local one -----

$GHCTL auth unauthenticated >/dev/null
$GHCTL token-echo stderr >/dev/null
fake_token='github_pat_LOCAL_TEST_TOKEN_ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
ship_preview "$tid" pr squash "gh-auth-$tid" "m" "t" "b"
_has_blocker "$tid" github-unavailable &&
	ok "a pushing ending is refused while GitHub is unauthenticated" ||
	fail "GitHub auth refusal" "$(_blockers "$tid")"
$GPGCTL warm
ship_preview "$tid" commit squash "gh-auth-local-$tid" "m" "" ""
jq -e '.deliverable' "/tmp/ship-preview-$tid.json" >/dev/null &&
	ok "a local signed commit needs no GitHub availability at all" ||
	fail "local ending independence" "$(_blockers "$tid")"
assert "auth-blocked clone remains unchanged" _clone_unchanged "$clone" "$baseline_head" "$baseline_status"
if grep -F "$fake_token" "$WS_OUT" >/dev/null 2>&1 || grep -Fi 'Authorization: Bearer' "$WS_OUT" >/dev/null 2>&1; then
	fail "GitHub preflight redaction" "credential-shaped fake output reached the WebSocket recording"
else
	ok "GitHub preflight observations and the delivery projection are redacted"
fi
$GHCTL token-echo off >/dev/null
$GHCTL auth login ompire-test >/dev/null

# --- leg 3: repository denial is named before any effect ----------------------

$GHCTL repository deny >/dev/null
ship_preview "$tid" pr squash "gh-deny-$tid" "m" "t" "b"
_has_blocker "$tid" github-unavailable &&
	ok "a denied repository refuses the pull-request ending" ||
	fail "repository denial refusal" "$(_blockers "$tid")"
assert "denied-repository clone remains unchanged" _clone_unchanged "$clone" "$baseline_head" "$baseline_status"
$GHCTL repository allow >/dev/null

# --- leg 4: a locked signing key refuses, and warming clears it ---------------

$GPGCTL lock
ship_preview "$tid" commit squash "gpg-locked-$tid" "m" "" ""
_has_blocker "$tid" signing-unavailable &&
	ok "a locked signing key refuses by name" ||
	fail "locked key refusal" "$(_blockers "$tid")"
assert "locked-key clone remains unchanged" _clone_unchanged "$clone" "$baseline_head" "$baseline_status"
$GPGCTL warm
api_json POST /api/gpg/recheck >/dev/null
[ "$(jq -r .state <<<"$API_BODY")" = ready ] &&
	ok "recheck says ready after warm" ||
	fail "gpg recheck after warm" "$API_BODY"
# The gate names the key it will sign with, not just that it can. gpgctl
# reports the primary; the daemon selects that primary's signing subkey.
[ "$(jq -r '.candidates[0].primary_fingerprint' <<<"$API_BODY")" = "$($GPGCTL fingerprint)" ] &&
	[ -n "$(jq -r '.selected.fingerprint' <<<"$API_BODY")" ] &&
	ok "recheck names the signing subkey of the configured primary" ||
	fail "gpg selected fingerprint" "$API_BODY"

# --- leg 5: an injected forge push rejection blocks, and a retry delivers -----

$FORGE reject-push local-test/sandbox >/dev/null
ship_deliver "$tid" push squash "pushfail" "Push fail" "b"
wait_for "the rejected push blocks the delivery" 120 ship_blocked "$tid"
ok "forge rejection stopped the delivery: $(ship_field "$tid" '.blocked_reason')"
[ -n "$(ship_field "$tid" '.results.commit.signed_tip')" ] &&
	ok "the signed result survives the failed push" ||
	fail "signed prefix retained" "$(ship_field "$tid" '.results')"

signed_before=$(ship_field "$tid" '.results.commit.signed_tip')
ship_deliver "$tid" push squash "pushfail-retry" "Push fail" "b"
wait_for "the retry delivers" 120 ship_done "$tid" push
[ "$(ship_field "$tid" '.results.commit.signed_tip')" = "$signed_before" ] &&
	ok "the retry reused the signed result rather than signing again" ||
	fail "retry reused the signature" "$(ship_field "$tid" '.results.commit')"

# --- leg 6: an injected gh create failure blocks, and a retry opens the PR ----

$GHCTL fail-next create >/dev/null
ship_deliver "$tid" pr squash "" "Fail then recover" "b"
wait_for "the injected create failure blocks the delivery" 120 ship_blocked "$tid"
grep -qi "injected create failure" <<<"$(ship_field "$tid" '.blocked_reason')" &&
	ok "the create failure is reported verbatim" ||
	fail "create failure detail" "$(ship_field "$tid" '.blocked_reason')"
ship_deliver "$tid" pr squash "" "Fail then recover" "b"
wait_for "the retry opens the pull request" 120 ship_done "$tid" pr
ok "recovered: pull request $(task_field "$tid" pr_url)"

# --- leg 7: retain refuses a dirty tree -------------------------------------

tid2=$(spawn_task "$(unique_slug retainfail)" "[[scenario:commit]]\nRetain refusal E2E: commit the work.")
wait_for "work step completes (retain leg)" 180 workflow_complete "$tid2"
clone2=$(task_field "$tid2" clone_path)
echo "stray" >"$clone2/uncommitted.txt"
approve_review "$tid2"
$GPGCTL warm
ship_preview "$tid2" commit retain "retain-dirty-$tid2" "" "" ""
_has_blocker "$tid2" retain-dirty &&
	ok "retain refuses a dirty tree and says which mode to use" ||
	fail "retain dirty refusal" "$(_blockers "$tid2")"
rm -f "$clone2/uncommitted.txt"

# --- leg 8: content that changed after approval cannot be delivered ----------

tid3=$(spawn_task "$(unique_slug stale)" "[[scenario:commit]]\nStale approval E2E: commit the work.")
wait_for "work step completes (stale leg)" 180 workflow_complete "$tid3"
clone3=$(task_field "$tid3" clone_path)
approve_review "$tid3"
$GPGCTL warm
ship_preview "$tid3" commit squash "fresh-$tid3" "m" "" ""
jq -e '.deliverable' "/tmp/ship-preview-$tid3.json" >/dev/null &&
	ok "the fresh approval covers the current content" ||
	fail "fresh approval" "$(_blockers "$tid3")"
echo "unreviewed change" >"$clone3/after-approval.txt"
ship_preview "$tid3" commit squash "stale-$tid3" "m" "" ""
_has_blocker "$tid3" review-stale &&
	ok "content changed after approval is refused rather than signed" ||
	fail "stale approval refusal" "$(_blockers "$tid3")"
assert "the stale-approval task started no action" _no_action_started "$tid3"

assert "task $tid never failed" task_not_failed "$tid"
assert "task $tid2 never failed" task_not_failed "$tid2"
assert "task $tid3 never failed" task_not_failed "$tid3"
[ -n "$(task_field "$tid" pr_url)" ] && ok "task retains its PR URL" ||
	fail "task PR URL" "missing after recovery phases"
