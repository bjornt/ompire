#!/usr/bin/env bash
#
# local-test/scenarios/ship-endings — a workflow's ending is what its author
# declared and what a person authorized, and it does not grow afterwards
# (ADR-0032, ADR-0033).
#
#   leg 1  stop at a local signed commit: nothing is pushed, no PR exists, and
#          the delivery is complete rather than half-finished
#   leg 2  that completed ending cannot be widened — not by asking for a
#          longer one, and not through the action endpoints
#   leg 3  a different run authorizes the pull-request chain, and gets all
#          three effects from the one answer that granted them
#   leg 4  cleanup of a local-only delivery keeps the journal it produced
#
# The three chains are separate answers to the same question, so each leg is
# its own run: "sign it" and "sign it, push it, and open a pull request" are
# different permissions, and no answer may grow into the next one.

set -euo pipefail
. "$(dirname "$0")/lib.sh"

ws_start

BARE=$STATE_ROOT/forge/github.com/local-test/sandbox.git

_forge_has_branch() { # _forge_has_branch BRANCH
	git -C "$BARE" rev-parse --verify -q "refs/heads/$1" >/dev/null 2>&1
}

tid=$(spawn_task "$(unique_slug endings)" "[[scenario:commit]]\nSelectable-endings E2E: do the work and commit it.")
clone=$(task_field "$tid" clone_path)
branch=$(task_field "$tid" branch)
approve_run_review "$tid"
wait_for "the run reaches its publication decision" 180 at_approval "$tid"
$GPGCTL warm

# --- leg 1: a local signed commit is a complete delivery ----------------------

receives_before=$($FORGE receives local-test/sandbox)
ship_deliver "$tid" commit-locally "ship: local only" "" ""
wait_for "the local ending completes" 120 ship_done "$tid" commit
wait_for "the run completes at its local ending" 60 workflow_complete "$tid"
[ "$(task_field "$tid" workflow_result)" = "committed-locally" ] &&
	ok "the run's result names the ending the answer authorized" ||
	fail "workflow result" "$(task_field "$tid" workflow_result)"

signed_tip=$(ship_field "$tid" '.results.commit.signed_tip')
[ "$signed_tip" = "$(git -C "$clone" rev-parse HEAD)" ] &&
	ok "the signed commit is installed at the task's HEAD" ||
	fail "signed result installed" "recorded $signed_tip, clone $(git -C "$clone" rev-parse HEAD)"
assert "the signed commit verifies in the clone" \
	forge_git -C "$clone" verify-commit HEAD
[ "$(git -C "$clone" status --porcelain)" = "" ] &&
	ok "the clone is clean against its own signed commit" ||
	fail "clone clean after signing" "$(git -C "$clone" status --porcelain)"
_forge_has_branch "$branch" &&
	fail "local ending pushed nothing" "the forge has $branch" ||
	ok "nothing reached the forge"
[ "$($FORGE receives local-test/sandbox)" = "$receives_before" ] &&
	ok "the forge received no push (still $receives_before)" ||
	fail "no push for a local ending" "receives moved"
[ -z "$(task_field "$tid" pr_url)" ] &&
	ok "no pull request was opened" ||
	fail "local ending opened a PR" "$(task_field "$tid" pr_url)"
[ "$(ship_field "$tid" '.results.pr')" = null ] &&
	ok "the delivery reports a completed local ending, not a failed PR" ||
	fail "local ending result" "$(ship_field "$tid" '.results')"

# --- leg 2: that ending stays the ending --------------------------------------

# Nothing is waiting to be answered any more, so there is nothing to authorize.
[ "$(ship_field "$tid" '.authority.source // "none"')" = "none" ] &&
	ok "a completed run offers no further authorization" ||
	fail "authority after completion" "$(ship_field "$tid" '.authority')"
ship_preview "$tid" "" "widen-$tid" "m" "t" "b"
[ "$API_CODE" = 409 ] &&
	ok "a preview with nothing to authorize is refused ($(jq -r '.detail.blockers[0].code // .detail.message // .detail' /tmp/ship-preview-$tid.json))" ||
	fail "widening refused at preview" "$API_CODE $(cat /tmp/ship-preview-$tid.json)"
# And the action endpoints refuse it just as plainly: there is no second door.
delivery=$(ship_field "$tid" '.delivery_id')
version=$(ship_field "$tid" '.version')
api_json POST "/api/tasks/$tid/ship/push" \
	"$(jq -n --argjson d "$delivery" --argjson v "$version" \
		'{ending: "push", request_id: "widen-push", preview_token: "no",
		  delivery_id: $d, expected_version: $v}')" >/dev/null
[ "$API_CODE" = 409 ] &&
	ok "the push endpoint refuses a completed narrower ending" ||
	fail "push endpoint refusal" "$API_CODE $API_BODY"
_forge_has_branch "$branch" &&
	fail "no push happened" "the forge has $branch" ||
	ok "still nothing on the forge"

# --- leg 3: a run whose answer authorizes the whole chain ----------------------

tid2=$(spawn_task "$(unique_slug pr-ending)" "[[scenario:commit]]\nPull-request ending E2E: do the work and commit it.")
branch2=$(task_field "$tid2" branch)
approve_run_review "$tid2"
wait_for "the second run reaches its decision" 180 at_approval "$tid2"
$GPGCTL warm
ship_deliver "$tid2" open-pr "ship: the whole chain" "Selectable endings" "opened last"
wait_for "the pull-request ending completes" 180 ship_done "$tid2" pr
pr_url=$(task_field "$tid2" pr_url)
[ -n "$pr_url" ] && ok "pull request opened: $pr_url" || fail "pr url" "empty"
# One answer, one authorization, three effects — and no extension anywhere.
[ "$(ship_field "$tid2" '[.decisions[] | select(.kind == "authorize")] | length')" = 1 ] &&
	[ "$(ship_field "$tid2" '[.decisions[] | select(.kind == "extend")] | length')" = 0 ] &&
	ok "one authorization covered the whole declared chain" ||
	fail "authorization history" "$(ship_field "$tid2" '[.decisions[].kind]')"
[ "$(ship_field "$tid2" '[.actions[] | select(.kind == "commit")] | length')" = 1 ] &&
	ok "the commit action ran exactly once" ||
	fail "commit attempts" "$(ship_field "$tid2" '[.actions[] | {kind, attempt, phase}]')"
[ "$(git -C "$BARE" rev-parse "refs/heads/$branch2")" = "$(ship_field "$tid2" '.results.commit.signed_tip')" ] &&
	ok "the forge branch holds the signed tip" ||
	fail "forge branch tip" "$(git -C "$BARE" rev-parse "refs/heads/$branch2")"

# --- leg 4: cleanup of a local-only delivery keeps its journal ----------------

tid3=$(spawn_task "$(unique_slug localonly)" "[[scenario:commit]]\nLocal-only E2E: do the work and commit it.")
approve_run_review "$tid3"
wait_for "the third run reaches its decision" 180 at_approval "$tid3"
$GPGCTL warm
ship_deliver "$tid3" commit-locally "ship: local only, cleaned up" "" ""
wait_for "the local-only delivery completes" 120 ship_done "$tid3" commit

api_json POST "/api/tasks/$tid3/cleanup" >/dev/null
[ "$API_CODE" = 200 ] || die "cleanup of a local-only delivery rejected ($API_CODE): $API_BODY"
[ "$(task_field "$tid3" state)" = archived ] &&
	ok "a local-only delivery can be cleaned up" ||
	fail "cleanup archived the task" "$(task_field "$tid3" state)"
# The journal outlives the workspace: what was published, and under whose
# authorization, is still answerable after the clone is gone.
[ -n "$(ship_field "$tid3" '.results.commit.signed_tip')" ] &&
	ok "the delivery record survives cleanup" ||
	fail "retained delivery record" "$(ship_projection "$tid3")"

assert "task $tid never failed" task_not_failed "$tid"
assert "task $tid2 never failed" task_not_failed "$tid2"
assert "task $tid3 never failed" task_not_failed "$tid3"
