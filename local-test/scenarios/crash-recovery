#!/usr/bin/env bash
#
# local-test/scenarios/crash-recovery — LOCAL-TESTING.PLAN.md Part 9, flow 7.
#
# SIGKILL the daemon mid-flight and prove recovery:
#   leg 1 (resume): hang the agent via a scenario directive, kill -9 the
#     daemon, restart — recovery relaunches the fake omp with --resume for
#     the recorded session, serves the recovery nudge, and the task
#     reaches completion again.
#   leg 2 (interrupted push): hold the delivery inside the forge's receive
#     window with a gated pre-receive hook, kill -9 the daemon while the
#     push action is journaled `executing`, release the gate, restart —
#     startup performs no new push, reconciles the attempt against what the
#     destination actually holds, and the task stays drivable.
#
# Forge surgery note: leg 2 arms and releases the forge's own gate through
# `local-test/forge`, in every exit path (EXIT trap).

set -euo pipefail
. "$(dirname "$0")/lib.sh"
PARKED_GATE=""
BARE_SANDBOX=$STATE_ROOT/forge/github.com/local-test/sandbox.git
_agent_live() { # _agent_live CLONE
	$OMPCTL sessions | awk -v clone="$1" '$0 ~ clone {print $1}' | grep -q .
}
_launch_count() { # _launch_count SESSION WANT
	local count
	count=$($OMPCTL transcript "$1" | jq -s '[.[] | select(.kind == "launch")] | length')
	[ "$count" -ge "$2" ] && printf '%s' "$count" || { printf 'launches=%s' "$count"; return 1; }
}
_parked_cleanup() {
	[ -z "$PARKED_GATE" ] || "$FORGE" gate local-test/sandbox off >/dev/null 2>&1 || true
}

# Reconciled: startup either adopted a completed push or established that it
# never happened. Either is a resolution; silence is not.
_push_reconciled() { # _push_reconciled TASK
	local phase
	phase=$(ship_field "$1" '[.actions[] | select(.kind == "push")][-1].phase // empty' || true)
	case "$phase" in
	succeeded | failed) printf '%s' "$phase"; return 0 ;;
	needs_reconciliation) printf 'unresolved (an explicit decision is required)'; return 0 ;;
	esac
	printf 'phase=%s' "${phase:-none}"
	return 1
}
register_cleanup _parked_cleanup

ws_start

# --- leg 1: resume after SIGKILL ------------------------------------------------

tid=$(spawn_work_only "$(unique_slug crash)" "[[scenario:auto-retry-hang]]
Keep working; the daemon will die under you.")
clone=$(task_field "$tid" clone_path)

# wait until the fake agent process is live for this clone
wait_for "fake agent live for the hung task" 90 _agent_live "$clone"
wait_for "hung turn reaches retrying" 90 \
	_ws_seen '.type == "status_changed" and .payload.to == "retrying"' "$tid"
session_id=$($OMPCTL sessions | awk -v clone="$clone" '$0 ~ clone {print $1}' | tail -1)
agent_pid=$($OMPCTL transcript "$session_id" | jq -r 'select(.kind == "launch") | .pid' | tail -1)
ok "agent session $session_id (pid $agent_pid) is the one that will orphan"

daemon_kill9
ws_stop
ok "daemon SIGKILLed"

daemon_start
ws_start
wait_for "session relaunch recorded" 60 _launch_count "$session_id" 2
# Recovery relaunches the same session id with --resume; the nudge prompt is
# then served and the workflow completes.
wait_for "workflow completes after recovery" 180 workflow_complete "$tid"
$OMPCTL transcript "$session_id" | jq -e --arg sid "$session_id" \
	'select(.kind == "launch" and .resume == $sid)' >/dev/null &&
	ok "relaunch carried --resume $session_id" ||
	fail "relaunch resume flag" "no launch record resumed $session_id"
$OMPCTL transcript "$session_id" | jq -e \
	'select(.kind == "prompt" and .scenario == "resume-nudge")' >/dev/null &&
	ok "recovery nudge served (resume-nudge)" ||
	fail "recovery nudge" "no resume-nudge prompt served"
assert "task never failed after recovery" task_not_failed "$tid"

# --- leg 2: an interrupted push is reconciled, never repeated -------------------

tid2=$(spawn_task "$(unique_slug parked)" "[[scenario:commit]]\nInterrupted-push E2E: do the work and commit it.")
approve_run_review "$tid2"
wait_for "the run reaches its publication decision" 180 at_approval "$tid2"
$GPGCTL warm

branch2=$(task_field "$tid2" branch)
PARKED_GATE=gate
$FORGE gate local-test/sandbox on

_push_executing() { # _push_executing TASK
	local payload
	payload=$(ship_projection "$1")
	[ -n "$payload" ] || { printf 'no projection yet'; return 1; }
	jq -e '[.actions[] | select(.kind == "push" and .phase == "executing")] | length >= 1' \
		<<<"$payload" >/dev/null || { printf 'no executing push'; return 1; }
	printf 'push executing'
}

ship_deliver "$tid2" push-branch "ship: interrupted push" "Interrupted" "b"
wait_for "push intent journaled as executing" 120 _push_executing "$tid2"
signed_tip=$(ship_field "$tid2" '.results.commit.signed_tip')
[ -n "$signed_tip" ] && ok "the signed result was recorded before the push began" ||
	fail "signed result recorded" "$(ship_projection "$tid2")"

daemon_kill9
ws_stop
ok "daemon SIGKILLed inside the push window"

$FORGE gate local-test/sandbox off
PARKED_GATE=""
sleep 1
landed=$(git -C "$BARE_SANDBOX" rev-parse --verify -q "refs/heads/$branch2" 2>/dev/null || printf none)
receives_after_kill=$($FORGE receives local-test/sandbox)
ok "forge received $receives_after_kill pushes before the restart (destination: ${landed:0:12})"

daemon_start
ws_start
wait_for "the interrupted delivery is reconciled" 90 _push_reconciled "$tid2"

# Whatever the destination actually holds, startup agreed with it — and it
# never wrote to the forge to find out.
[ "$($FORGE receives local-test/sandbox)" = "$receives_after_kill" ] &&
	ok "startup performed no new push (receives unchanged at $receives_after_kill)" ||
	fail "no push on startup" "receives moved from $receives_after_kill to $($FORGE receives local-test/sandbox)"

phase=$(ship_field "$tid2" '[.actions[] | select(.kind == "push")][-1].phase')
if [ "$landed" = "$signed_tip" ]; then
	[ "$phase" = succeeded ] &&
		ok "the completed push was adopted rather than repeated" ||
		fail "adopted completed push" "destination holds the signed tip but the attempt is $phase"
else
	[ "$phase" = failed ] || [ "$phase" = needs_reconciliation ] &&
		ok "the unlanded push was not treated as done (phase $phase)" ||
		fail "unlanded push classification" "phase $phase with destination at $landed"
fi

assert "interrupted-push task never failed" task_not_failed "$tid2"
