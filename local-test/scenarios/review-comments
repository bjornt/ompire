#!/usr/bin/env bash
#
# local-test/scenarios/review-comments — a review's comments drive the
# *declared* correction route, not a hidden prompt (ADR-0033).
#
# The pre-format-3 daemon pushed llmvet's comments straight into the primary
# session. The loop was invisible in the flow, unbounded, and impossible to
# route around. Here the reviewer's report is recorded evidence, and the
# workflow's own edge carries it back to the worker — so this runbook proves
# both halves: the correction turn happens, and it happens because the
# definition says so.
#
#   1. the run reaches its review step and llmvet leaves a comment
#   2. the recorded iteration carries the whole report, not a count
#   3. the run routes back to `work`, whose prompt contains that report
#   4. a second review approves, and the run reaches its approval

set -euo pipefail
. "$(dirname "$0")/lib.sh"

_review_iterations() { # _review_iterations TASK
	ws_count '.type == "review_iteration" and .payload.task_id == '"$1"''
}
_iterations_at_least() { # _iterations_at_least TASK N
	local n
	n=$(_review_iterations "$1")
	[ "$n" -ge "$2" ] && printf '%s' "$n" || { printf 'iterations=%s want>=%s' "$n" "$2"; return 1; }
}

ws_start
tid=$(spawn_task "$(unique_slug rc)" "Review-comments E2E: make a change worth commenting on.")

# --- iteration 1: comment → the declared correction route --------------------

url=$(wait_for "the run starts its review step" 180 run_review_url "$tid")
ok "iteration 1 open at $url"
wait_for "iteration 1 llmvet ready" 30 review_ready "$url"

comment="Please reword the intro paragraph."
$REVIEW comment --url "$url" --file README.md --line 1 --body "$comment"
ok "comment submitted via llmvet"

wait_for "comment iteration recorded" 60 \
	_ws_seen '.type == "review_iteration" and .payload.iteration.outcome == "comments"' "$tid"

# The report itself is retained, and its state says so. A count is not a
# report, and a correction may only run against a complete one.
# The report is multi-line prose, so it is searched whole rather than by line.
jq -r "select(.type == \"review_iteration\" and .payload.task_id == $tid) | .payload.iteration.findings // empty" \
	"$WS_OUT" | grep -qF "$comment" &&
	ok "the recorded iteration carries the reviewer's own report" ||
	fail "retained findings" "$(jq -r "select(.type == \"review_iteration\") | .payload.iteration.findings // \"(none)\"" "$WS_OUT" | head -c 300)"
state=$(jq -r "select(.type == \"review_iteration\" and .payload.task_id == $tid) | .payload.iteration.findings_state // empty" \
	"$WS_OUT" | tail -1)
[ "$state" = complete ] &&
	ok "the report is recorded complete, so a correction may run against it" ||
	fail "findings_state" "$state"

# --- the correction turn is the workflow's own edge --------------------------

clone=$(task_field "$tid" clone_path)
session=$($OMPCTL sessions | awk -v clone="$clone" '$0 ~ clone {print $1}' | tail -1)
[ -n "$session" ] || die "no session recorded for clone $clone"
wait_for "the declared correction step re-prompts the worker" 120 \
	bash -c "'$OMPCTL' transcript '$session' | grep -qF '$comment'"
ok "the reviewer's report reached the worker through the declared route"
# It is a step in the run's own history, not a turn nobody declared.
task_get "$tid" | jq -e '[.workflow_steps[] | select(.step == "work")] | length >= 2' >/dev/null &&
	ok "the correction is a second attempt of the declared work step" ||
	fail "declared correction attempt" "$(task_get "$tid" | jq -c '[.workflow_steps[] | {step, status}]')"

# --- iteration 2: approve → the run reaches its decision ---------------------

# A second reviewer, for the corrected content. Its URL may reuse the port the
# first one released — what matters is that the run started a second review.
url2=$(wait_for "the run starts its second review" 180 run_review_url "$tid" 1)
ok "iteration 2 open at $url2"
wait_for "iteration 2 llmvet ready" 30 review_ready "$url2"
$REVIEW approve --url "$url2"
wait_for "review finished approved" 60 \
	_ws_seen '.type == "review_finished" and .payload.status == "approved"' "$tid"
wait_for "the run reaches its publication decision" 120 at_approval "$tid"
ok "the approved review led to the decision, and nothing was published on the way"

assert "at least two review iterations were recorded" _iterations_at_least "$tid" 2
assert "task never failed" task_not_failed "$tid"
