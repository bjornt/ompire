#!/usr/bin/env bash
#
# local-test/scenarios/review-comments — LOCAL-TESTING.PLAN.md Part 9, flow 3.
#
# Comment loopback through the real llmvet UI: start a review, submit an
# inline comment (`local-test/review comment`), observe the daemon loop it
# back to the live agent as a prompt (fake omp classifies it
# review-comments and answers), the iteration conclude `comments`, and a
# second iteration that approves conclude the review.

set -euo pipefail
. "$(dirname "$0")/lib.sh"

_second_review_started() { # _second_review_started TASK_ID — true once 2nd
	# review_started event for the task is on the wire
	[ "$(jq -c "select(.type == \"review_started\" and .payload.task_id == $1)" "$WS_OUT" 2>/dev/null | grep -c .)" -ge 2 ]
}
_idle_count_gt() { # _idle_count_gt TASK PRIOR
	[ "$(ws_count '.type == "status_changed" and .payload.to == "idle" and .payload.task_id == '"$1"'')" -gt "$2" ]
}

ws_start review_started review_finished
tid=$(spawn_task "$(unique_slug rc)" "Review-comments E2E: make a change worth commenting on.")
wait_for "work step completes" 180 workflow_complete "$tid"

# --- iteration 1: comment → loopback → outcome comments ----------------------

review=$(wait_for "review gate accepts" 60 review_open "$tid")
url=$(jq -r .url <<<"$review")
ok "iteration 1 open at $url"
wait_for "iteration 1 llmvet ready" 30 review_ready "$url"
idle_before=$(ws_count '.type == "status_changed" and .payload.to == "idle" and .payload.task_id == '"$tid"'')

comment="Please reword the intro paragraph."
$REVIEW comment --url "$url" --file README.md --line 1 --body "$comment"
ok "comment submitted via llmvet"

# Once the daemon's comment-loopback prompt returns idle, explicitly open the
# next review iteration through the same public gate.
wait_for "comment iteration recorded" 60 \
	_ws_seen '.type == "review_iteration" and .payload.iteration.outcome == "comments"' "$tid"
wait_for "comment loopback returns idle" 120 _idle_count_gt "$tid" "$idle_before"
review2=$(wait_for "second review gate accepts" 60 review_open "$tid")
url2=$(jq -r .url <<<"$review2")
[ -n "$url2" ] && [ "$url2" != null ] || die "no second review url returned"
wait_for "second review_started observed" 30 _second_review_started "$tid"
ok "iteration 2 open at $url2"
wait_for "iteration 2 llmvet ready" 30 review_ready "$url2"

# --- iteration 2: approve → review concluded ----------------------------------

$REVIEW approve --url "$url2"
ok "iteration 2 approved"

wait_for "review finished approved" 60 \
	_ws_seen '.type == "review_finished" and .payload.status == "approved"' "$tid"

clone=$(task_field "$tid" clone_path)
session=$($OMPCTL sessions | awk -v clone="$clone" '$0 ~ clone {print $1}' | tail -1)
assert "iteration outcome 'comments' observed on WS" \
	_ws_seen '.type == "review_iteration" and .payload.iteration.outcome == "comments"' "$tid"
[ -n "$session" ] || die "no session recorded for clone $clone"
assert "loopback prompt delivered to the agent (transcript)" \
	bash -c "'$OMPCTL' transcript '$session' | grep -F '$comment'"
assert "agent classified the loopback as review-comments" \
	bash -c "'$OMPCTL' transcript '$session' | grep -F '\"scenario\":\"review-comments\"'"

assert "task never failed" task_not_failed "$tid"
